  "accueil.01": {
   "fr": "Je raconte des histoires en images",
   "en": "I tell stories through visuals"
  },
  "accueil.02": {
   "fr": "Basée en Suisse &nbsp;·&nbsp; Projets en Suisse et à l'international",
   "en": "Based in Switzerland &nbsp;·&nbsp; Projects in Switzerland and abroad"
  },
  "accueil.03": {
   "fr": "découvrir mon travail",
   "en": "see my work"
  },
  "collab.01": {
   "fr": "En collaboration avec",
   "en": "In collaboration with"
  },
  "apropos.01": {
   "fr": "À propos",
   "en": "About"
  },
  "apropos.02": {
   "fr": "Bonjour, je suis Capucine",
   "en": "Hello, I'm Capucine"
  },
  "apropos.03": {
   "fr": "Photographe et créatrice de contenu visuel, je raconte en images l'univers des hôtels, des spas, des instituts de beauté, des restaurants et des marques lifestyle.",
   "en": "As a photographer and visual content creator, I capture the world of hotels, spas, beauty institutes, restaurants and lifestyle brands through imagery."
  },
  "apropos.04": {
   "fr": "Formée en photographie à Cambridge et en marketing et communication à Milan, j'associe sensibilité artistique et compréhension de l'identité des marques pour créer des images qui leur ressemblent. Basée en Suisse, je souhaite collaborer avec des établissements et des marques qui accordent une importance particulière à l'esthétique, à l'expérience et aux détails.",
   "en": "Having studied photography in Cambridge and marketing and communication in Milan, I combine artistic sensitivity with an understanding of brand identity to create images that truly reflect each brand. Based in Switzerland, I am looking to collaborate with establishments and brands that place particular importance on aesthetics, experience and attention to detail."
  },
  "apropos.05": {
   "fr": "Une lumière de fin de journée sur un mur de pierre, le reflet d'un marbre, une texture, un geste ou un détail soigneusement pensé : je cherche ce qui rend chaque lieu ou chaque marque unique, puis je le traduis en images. Mon approche associe photographie, esthétique et storytelling visuel, avec une attention particulière portée à la lumière, aux matières et aux ambiances.",
   "en": "The late-afternoon light falling on a stone wall, the reflection on a marble surface, a texture, a gesture or a thoughtfully curated detail: I seek out what makes each place or brand unique and translate it into imagery. My approach brings together photography, aesthetics and visual storytelling, with a particular focus on light, materials and atmosphere."
  },
  "apropos.06": {
   "fr": "J'accompagne les marques dans la création de contenus destinés à leurs sites internet, leurs réseaux sociaux et leurs campagnes, afin de valoriser leur identité et de créer une expérience visuelle cohérente.",
   "en": "I work with brands to create visual content for their websites, social media platforms and campaigns, helping to showcase their identity and build a cohesive visual experience."
  },
  "apropos.07": {
   "fr": "Mes Domaines d'Expertise",
   "en": "My Areas of Expertise"
  },
  "apropos.08": {
   "fr": "Photographie &amp; Création de Contenu · Communication Digitale · Branding · Événementiel",
   "en": "Photography &amp; Content Creation · Digital Communication · Branding · Events"
  },
  "apropos.09": {
   "fr": "Mes Univers",
   "en": "My Areas of Interest"
  },
  "apropos.10": {
   "fr": "Luxe · Hôtellerie · Wellness &amp; Beauté · Lifestyle · Gastronomie · Événementiel",
   "en": "Luxury · Hospitality · Wellness &amp; Beauty · Lifestyle · Food &amp; Dining · Events"
  },
  "apropos.11": {
   "fr": "Travailler Ensemble",
   "en": "Let's Work Together"
  },
  "portfolio.01": {
   "fr": "Séries choisies",
   "en": "Selected series"
  },
  "portfolio.02": {
   "fr": "Chaque série raconte un lieu. Choisissez-en une pour la parcourir, ou ouvrez une photo en grand.",
   "en": "Each series tells the story of a place. Select one to explore, or click on a photograph to view it in full size."
  },
  "livres.01": {
   "fr": "Publications",
   "en": "Publications"
  },
  "livres.02": {
   "fr": "Livres photo",
   "en": "Photo books"
  },
  "livres.03": {
   "fr": "Deux livres photo conçus de la prise de vue à la mise en page. Cliquez sur une couverture pour le feuilleter.",
   "en": "Two photo books, created from the initial photography to the final layout. Click on a cover to browse through the book."
  },
  "livres.04": {
   "fr": "avril 2025",
   "en": "April 2025"
  },
  "livres.05": {
   "fr": "Projet de fin d'études, Cambridge School of Art (BA Hons Photography). Une immersion dans les boutiques Nespresso : du grain à la tasse, la lumière, les matières et le plaisir de la dégustation.",
   "en": "Major project, Cambridge School of Art (BA Hons Photography). An exploration of Nespresso boutiques, from bean to cup, capturing the light, textures and pleasure of the tasting experience."
  },
  "livres.06": {
   "fr": "Feuilleter",
   "en": "Browse"
  },
  "livres.07": {
   "fr": "mai 2024",
   "en": "May 2024"
  },
  "livres.08": {
   "fr": "Projet de fin d'études, Cambridge School of Art (BA Hons Photography). Un livre sur les émotions que provoquent les lieux : ombres, symétrie, formes, matières et détails, photographiés dans des hôtels et des espaces de bien-être.",
   "en": "Major project, Cambridge School of Art (BA Hons Photography). A photography book exploring the emotions evoked by places through shadows, symmetry, shapes, textures and details, captured in hotels and wellness spaces."
  },
